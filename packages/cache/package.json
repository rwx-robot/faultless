{
  "name": "@faultless/cache",
  "version": "7.0.0",
  "description": "nofault Caching - Redis, Local, Distributed Cache",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "test": "vitest run",
    "dev": "vitest"
  },
  "dependencies": {
    "@faultless/core": "workspace:*",
    "@faultless/log": "workspace:*",
    "@faultless/config": "workspace:*",
    "ioredis": "^5.3.0",
    "lru-cache": "^10.0.0"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "unbuild": "catalog:",
    "@types/node": "catalog:"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nofault-framework/nofault.git"
  },
  "homepage": "https://github.com/nofault-framework/nofault#readme",
  "bugs": {
    "url": "https://github.com/nofault-framework/nofault/issues"
  },
  "keywords": [
    "nofault",
    "cache",
    "redis",
    "lru",
    "distributed-cache"
  ]
}
