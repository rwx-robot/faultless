{
  "name": "@faultless/rpc",
  "version": "6.0.0",
  "description": "nofault RPC Framework - gRPC/Protobuf Support",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "test": "vitest run",
    "dev": "vitest"
  },
  "dependencies": {
    "@faultless/core": "workspace:*",
    "@faultless/log": "workspace:*",
    "@faultless/config": "workspace:*",
    "@faultless/breaker": "workspace:*",
    "@faultless/limit": "workspace:*",
    "@faultless/discovery": "workspace:*",
    "@faultless/resilience": "workspace:*",
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.0",
    "protobufjs": "^7.2.0"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "unbuild": "catalog:",
    "@types/node": "catalog:"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nofault-framework/nofault.git"
  },
  "homepage": "https://github.com/nofault-framework/nofault#readme",
  "bugs": {
    "url": "https://github.com/nofault-framework/nofault/issues"
  },
  "keywords": [
    "nofault",
    "rpc",
    "grpc",
    "protobuf",
    "microservice"
  ]
}
