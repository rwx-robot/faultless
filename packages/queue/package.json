{
  "name": "@faultless/queue",
  "version": "12.0.0",
  "description": "nofault Queue - Message Queue with Redis/RabbitMQ/Kafka Support",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "test": "vitest run",
    "dev": "vitest"
  },
  "dependencies": {
    "@faultless/core": "workspace:*",
    "ioredis": "^5.3.0",
    "amqplib": "^0.10.0"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "unbuild": "catalog:",
    "@types/node": "catalog:"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nofault-framework/nofault.git"
  },
  "homepage": "https://github.com/nofault-framework/nofault#readme",
  "bugs": {
    "url": "https://github.com/nofault-framework/nofault/issues"
  },
  "keywords": [
    "nofault",
    "queue",
    "message-queue",
    "bull",
    "amqp"
  ]
}
