{
  "name": "@faultless/http",
  "version": "0.0.0",
  "description": "HTTP server framework for nofault",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@faultless/core": "workspace:*",
    "@faultless/config": "workspace:*",
    "@faultless/log": "workspace:*",
    "fastify": "^4.28.0",
    "@fastify/helmet": "^11.1.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/compress": "^6.5.0",
    "@fastify/rate-limit": "^9.1.0"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "eslint": "catalog:",
    "unbuild": "catalog:",
    "@types/node": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "unbuild": {
    "failOnWarn": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nofault-framework/nofault.git"
  },
  "homepage": "https://github.com/nofault-framework/nofault#readme",
  "bugs": {
    "url": "https://github.com/nofault-framework/nofault/issues"
  },
  "keywords": [
    "nofault",
    "http",
    "fastify",
    "rest",
    "api",
    "server"
  ],
  "license": "MIT"
}
