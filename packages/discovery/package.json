{
  "name": "@faultless/discovery",
  "version": "0.0.0",
  "description": "Service discovery for nofault",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@faultless/core": "workspace:*",
    "@faultless/log": "workspace:*",
    "@faultless/config": "workspace:*",
    "etcd3": "^1.1.0",
    "consul": "^1.0.0",
    "@kubernetes/client-node": "^1.0.0"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "eslint": "catalog:",
    "unbuild": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nofault-framework/nofault.git"
  },
  "homepage": "https://github.com/nofault-framework/nofault#readme",
  "bugs": {
    "url": "https://github.com/nofault-framework/nofault/issues"
  },
  "keywords": [
    "nofault",
    "service-discovery",
    "etcd",
    "consul",
    "registry"
  ],
  "license": "MIT"
}
