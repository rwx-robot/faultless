{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@faultless/core": ["packages/core/src"],
      "@faultless/http": ["packages/http/src"],
      "@faultless/rpc": ["packages/rpc/src"],
      "@faultless/config": ["packages/config/src"],
      "@faultless/log": ["packages/log/src"],
      "@faultless/breaker": ["packages/breaker/src"],
      "@faultless/limit": ["packages/limit/src"],
      "@faultless/cache": ["packages/cache/src"],
      "@faultless/store": ["packages/store/src"],
      "@faultless/discovery": ["packages/discovery/src"],
      "@faultless/tracing": ["packages/tracing/src"],
      "@faultless/metrics": ["packages/metrics/src"],
      "@faultless/gateway": ["packages/gateway/src"],
      "@faultless/cli": ["packages/cli/src"],
      "@faultless/validation": ["packages/validation/src"],
      "@faultless/queue": ["packages/queue/src"],
      "@faultless/auth": ["packages/auth/src"],
      "@faultless/governance": ["packages/governance/src"],
      "@faultless/concurrency": ["packages/concurrency/src"],
      "@faultless/bloom": ["packages/bloom/src"],
      "@faultless/retry": ["packages/retry/src"],
      "@faultless/circuit-breaker": ["packages/circuit-breaker/src"],
      "@faultless/collection": ["packages/collection/src"],
      "@faultless/fx": ["packages/fx/src"],
      "@faultless/mr": ["packages/mr/src"],
      "@faultless/stream": ["packages/stream/src"],
      "@faultless/event": ["packages/event/src"],
      "@faultless/worker": ["packages/worker/src"]
    }
  },
  "exclude": ["node_modules", "dist", "examples", "tests", "docs"]
}